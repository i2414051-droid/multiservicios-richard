# Copiar como .env y completar los valores
SECRET_KEY=clave_secreta_segura_aqui

# Base de datos MySQL — BD Almacen (productos, proveedores, pedidos)
MYSQL_HOST=mysql-proyecto.alwaysdata.net
MYSQL_USER=proyecto
MYSQL_PASSWORD=tu_password_aqui
MYSQL_DB_ALMACEN=proyecto_gestion_almacen

# Login PROPIO del micro de almacén (Arreglo 2).
# Si no se definen, se usan admin / almacen123 (cámbialos en producción).
ALMACEN_ADMIN_USER=admin
ALMACEN_ADMIN_PASSWORD=almacen123

# Clave interna para llamadas entre microservicios (API)
INTERNAL_API_KEY=clave-interna-ms-almacen-2026

# URL del microservicio de Clientes/Ventas (para consultar ventas)
MS_VENTAS_URL=http://localhost:5000

# Correo SMTP (Gmail recomendado)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_app_password_gmail
