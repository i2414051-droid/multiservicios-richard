# Copiar como .env y completar los valores
SECRET_KEY=clave_secreta_segura_aqui

# Base de datos MySQL
MYSQL_HOST=mysql-proyecto.alwaysdata.net
MYSQL_PORT=3306
MYSQL_USER=proyecto
MYSQL_PASSWORD=tu_password_aqui
MYSQL_DB=proyecto_multiservicios_richard
MYSQL_CHARSET=utf8mb4
MYSQL_CONNECT_TIMEOUT=5
# Conexiones simultaneas por worker del pool interno de app.py.
# max_user_connections en alwaysdata es 40: workers x este valor debe quedar abajo.
MYSQL_POOL_SIZE=8

# Segundo modo de depuración: poner a 1 para ver el error exacto en pantalla
# (solo mientras se depura; dejar vacío o 0 en producción)
DEBUG_ERRORS=0

# Panel de KPIs (/panel): segundos que se guarda el snapshot en memoria.
# Calcularlo cuesta ~22 consultas (~4-5 s con la BD remota). El panel se
# refresca solo cada 120 s, asi que con 180 s la mayoria de los refrescos
# son instantaneos y el recalculo real ocurre cada ~4 min.
# Poner 0 para desactivar la cache (siempre datos frescos; el boton
# "Actualizar" ya fuerza datos frescos con forzar=1).
KPI_CACHE_TTL=180

# Segunda base de datos: Gestion de Almacen (productos, proveedores, para pedir)
MYSQL_DB_ALMACEN=proyecto_gestion_almacen

# Microservicios internos
MS_ALMACEN_URL=http://localhost:5001
MS_VENTAS_URL=http://localhost:5000

# Correo SMTP (Gmail recomendado)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_app_password_gmail

# API Peru (DNI/RUC)
APIPERU_TOKEN=tu_token_aqui

# ── Culqi (pasarela de pago) ──
# Se obtienen en https://culqipanel.culqi.com → Desarrollo → API Keys.
# Usar las de PRUEBA (pk_test_ / sk_test_) mientras se valida el flujo.
# La llave secreta solo se configura en el servidor (.env o Render → Environment)
# y NUNCA se sube al repositorio.
CULQI_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
CULQI_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
CULQI_CURRENCY=PEN
# Llaves RSA (opcionales): solo cifran el payload del checkout.
# CULQI_RSA_ID=
# CULQI_RSA_PUBLIC_KEY=
# Monto minimo aceptado por Culqi, en centimos (300 = S/ 3.00).
# CULQI_MONTO_MINIMO=300
# Tiempo maximo de espera contra la API de Culqi, en segundos.
# CULQI_TIMEOUT=20

# ── Seguridad / despliegue ──
# Render define RENDER=1 solo. Con eso la app confia en X-Forwarded-For/Proto
# (IP real del visitante) y pone la cookie de sesion como Secure (solo HTTPS).
# En otro proxy inverso sin esa variable, pon TRAS_PROXY=1.
# TRAS_PROXY=1
# Forzar/desactivar la cookie Secure a mano (0/1). Por defecto: 1 en Render.
# SESSION_COOKIE_SECURE=1
# Tamano maximo de subida en MB (fotos de productos, comprobantes).
MAX_CONTENT_MB=16

# ── reCAPTCHA v2 (casilla "No soy un robot") ──
# Protege SOLO /registro (el formulario que crea cuentas). El login se dejo
# fuera a proposito: lo cubren el bloqueo por intentos y el rate limiting.
# Se obtienen en https://www.google.com/recaptcha/admin creando un sitio de
# tipo "reCAPTCHA v2" -> "No soy un robot" Checkbox.
#
# IMPORTANTE: en la consola de Google hay que registrar TODOS los dominios
# desde donde se usara (localhost, 127.0.0.1, el dominio de Render y el dominio
# personalizado). Si falta alguno, el widget muestra "Invalid site key" y la
# verificacion responde invalid-input-response, aunque las claves sean buenas.
#
# La site key es publica (se renderiza en el HTML). La secret key NUNCA se sube
# al repositorio: solo va en .env (local) y en Render -> Environment (produccion).
#
# Si falta cualquiera de las dos, el captcha se desactiva solo: los formularios
# se dibujan sin widget y no se valida, para no bloquear un entorno sin configurar.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Tiempo maximo de espera contra la API de Google, en segundos.
# RECAPTCHA_TIMEOUT=9

# ── Google OAuth ("Iniciar sesion con Google") ──
# Credenciales en Google Cloud Console -> APIs y servicios -> Credenciales ->
# ID de cliente OAuth (tipo "Aplicacion web"). El SECRET solo vive en el
# servidor y NUNCA se sube al repositorio.
#
# En "URIs de redireccionamiento autorizados" deben figurar EXACTAMENTE las
# mismas URLs de abajo (local y produccion).
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret

# Callback local y de produccion. La app elige segun el entorno: en Render o
# con GOOGLE_ENTORNO=prod usa el de produccion; en local, el de localhost.
GOOGLE_REDIRECT_URI_LOCAL=http://localhost:5000/auth/google/callback
GOOGLE_FRONTEND_LOCAL=http://localhost:5000
GOOGLE_REDIRECT_URI_PROD=https://multiserviciosrichard.com/auth/google/callback
GOOGLE_FRONTEND_PROD=https://multiserviciosrichard.com
# Forzar un entorno concreto ('prod') o una URI propia (prioridad maxima).
# GOOGLE_ENTORNO=prod
# GOOGLE_REDIRECT_URI=

# ── API v1 (app movil) ──
# 1 = monta /api/v1; 0 = la deja apagada y la web sigue igual.
API_V1_ENABLED=1
# Firma de los JWT. En produccion usar un valor aleatorio DISTINTO de SECRET_KEY.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ACCESS_MINUTOS=30
JWT_REFRESH_DIAS=30
# Base publica para el enlace de recuperacion que se envia por correo.
# PUBLIC_BASE_URL=https://multiserviciosrichard.com
# Si el registro de la API debe exigir reCAPTCHA, usa las mismas claves de
# arriba. El hostname solo se valida si se activa explicitamente.
# RECAPTCHA_VALIDAR_HOST=1
# RECAPTCHA_HOST=multiserviciosrichard.com
